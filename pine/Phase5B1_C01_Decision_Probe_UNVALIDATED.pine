//@version=6
indicator("Phase 5B1 C01 Decision Probe — UNVALIDATED", overlay = false)
// Diagnostic source only. No trading signals, orders, alerts or validation claim.
const int DATA_START = timestamp("01 Nov 2026 00:00 +0000")
const int TRADE_START = timestamp("04 Nov 2026 00:00 +0000")
const int TRADE_END = timestamp("01 Dec 2026 00:00 +0000")
const int STEP = 900000
const int HOUR = 3600000
if not chart.is_standard or timeframe.in_seconds() != 900
    runtime.error("Requires a standard 15-minute chart in a separately authorized non-Holdout environment")

// Only called inside the authorized time branch. No implicit indicator history.
f_valid() =>
    not na(open) and not na(high) and not na(low) and not na(close) and low > 0 and low <= open and open <= high and low <= close and close <= high

f_chart_state() =>
    var bool healthy = false
    var bool poisoned = false
    var int n = 0
    var int lastEnd = na
    var float previousClose = na
    var float fast = na
    var float slow = na
    var float seedSum = 0.0
    var float atr = na
    float tr = na
    bool inside = time >= DATA_START and time < TRADE_END
    if time < DATA_START
        healthy := false
        poisoned := false
        n := 0
        lastEnd := na
        previousClose := na
        fast := na
        slow := na
        seedSum := 0.0
        atr := na
    if inside and barstate.isconfirmed
        bool contiguous = n == 0 ? time == DATA_START : time == lastEnd
        if poisoned or not contiguous or time_close != time + STEP or not f_valid()
            poisoned := true
            healthy := false
        else
            tr := n == 0 ? high - low : math.max(high - low, math.max(math.abs(high - previousClose), math.abs(low - previousClose)))
            fast := n == 0 ? close : (2.0 / 21.0) * close + (1.0 - 2.0 / 21.0) * fast
            slow := n == 0 ? close : (2.0 / 51.0) * close + (1.0 - 2.0 / 51.0) * slow
            n += 1
            if n <= 14
                seedSum += tr
                atr := n == 14 ? seedSum / 14.0 : na
            else
                atr := (1.0 / 14.0) * tr + (1.0 - 1.0 / 14.0) * atr
            previousClose := close
            lastEnd := time_close
            healthy := true
    bool available = inside and healthy and not poisoned and barstate.isconfirmed
    [available ? fast : na, available ? slow : na, available ? atr : na, available ? tr : na, available ? n : 0]

// Frozen research assumptions, not account-specific or verified historical rules.
const float TICK = 0.10
const float QSTEP = 0.001
const float K_COST_STOP = 2.5
const float FEE = 0.00055
const float FRICTION = 0.0002
bool fixtureEnabled = input.bool(false, "Enable SYNTHETIC diagnostic acceptance only")
float fixtureBalance = input.float(10000.0, "Synthetic pre-Funding settled-flat snapshot")
bool fixtureBusy = input.bool(false, "Synthetic position or pending occupancy")
bool fixtureDailyStop = input.bool(false, "Synthetic daily-stop state")
// No snapshot is evolved from prices. No entry/exit or filled-position state.
f_ticks(float raw, int direction) =>
    direction == 1 ? int(math.floor(raw / TICK)) : int(math.ceil(raw / TICK))

[fast, slow, atr, tr, count] = f_chart_state()
int i = count - 1
var array<int> lowIds = array.new<int>()
var array<float> lowPrices = array.new<float>()
var array<int> highIds = array.new<int>()
var array<float> highPrices = array.new<float>()
var array<int> consumedLong = array.new<int>()
var array<int> consumedShort = array.new<int>()
bool active = time >= DATA_START and time < TRADE_END and barstate.isconfirmed and count > 0 and not na(atr)
// Strict pivots need seven authorized observations; ATR readiness is not needed
// to discover warm-up pivots, so this separate gate uses authorized fast/count.
bool numericValid = time >= DATA_START and time < TRADE_END and barstate.isconfirmed and count > 0 and not na(fast)
if numericValid
    if count >= 7
        bool pl = true
        bool ph = true
        for k = 0 to 6
            if k != 3
                pl := pl and low[3] < low[k]
                ph := ph and high[3] > high[k]
        if pl
            array.push(lowIds, i - 3)
            array.push(lowPrices, low[3])
        if ph
            array.push(highIds, i - 3)
            array.push(highPrices, high[3])
    while array.size(lowIds) > 0
        if array.get(lowIds, 0) >= i - 80
            break
        array.shift(lowIds)
        array.shift(lowPrices)
    while array.size(highIds) > 0
        if array.get(highIds, 0) >= i - 80
            break
        array.shift(highIds)
        array.shift(highPrices)

bool window = time >= DATA_START and time_close >= TRADE_START and time_close < TRADE_END
bool accepted = false
int side = 0
int p = na
int pivotId = na
int slTicks = na
int tp1Ticks = na
int tp2Ticks = na
int totalSteps = na
int firstSteps = na
int secondSteps = na
float rr1 = na
float rr2 = na
if active and window and count >= 200
    side := fast > slow and close > slow ? 1 : fast < slow and close < slow ? -1 : 0
    if side != 0
        for age = 2 to 5
            float depth = side == 1 ? fast[age] - low[age] : high[age] - fast[age]
            if not na(atr[age]) and low[age] <= fast[age] and fast[age] <= high[age] and depth <= 0.75 * atr[age]
                p := age
                break
    bool sequence = not na(p)
    if sequence
        for age = 0 to p
            sequence := sequence and (side == 1 ? close[age] > slow[age] : close[age] < slow[age])
    bool trigger = side == 1 ? close > open and close > fast and close > high[1] : side == -1 ? close < open and close < fast and close < low[1] : false
    if sequence and trigger
        array<int> ids = side == 1 ? lowIds : highIds
        array<float> prices = side == 1 ? lowPrices : highPrices
        float pivotPrice = na
        int k = array.size(ids) - 1
        while k >= 0
            float value = array.get(prices, k)
            if side == 1 ? value < close : value > close
                pivotPrice := value
                pivotId := DATA_START + array.get(ids, k) * STEP
                break
            k -= 1
        if not na(pivotPrice)
            slTicks := f_ticks(pivotPrice - side * 0.15 * atr, side)
            // Render integer ticks by division: no reconstructing grid counters.
            float sl = slTicks / 10.0
            float risk = math.abs(close - sl)
            bool stopSide = side == 1 ? 0 < sl and sl < close : sl > close
            float cost = (close + sl) * (FEE + FRICTION)
            if stopSide and risk >= 0.75 * atr and risk <= 2.5 * atr and cost > 0 and risk / cost >= K_COST_STOP
                tp1Ticks := f_ticks(close + side * 1.5 * risk, side)
                tp2Ticks := f_ticks(close + side * 2.5 * risk, side)
                float tp1 = tp1Ticks / 10.0
                float tp2 = tp2Ticks / 10.0
                bool geometry = side == 1 ? tp2 > tp1 and tp1 > close : 0 < tp2 and tp2 < tp1 and tp1 < close
                bool bounds = close >= 0.1 and close <= 1999999.8 and slTicks >= 1 and slTicks <= 19999998 and tp1Ticks >= 1 and tp1Ticks <= 19999998 and tp2Ticks >= 1 and tp2Ticks <= 19999998
                if geometry and bounds and not na(fixtureBalance) and fixtureBalance > 0
                    float rawQty = math.min(0.0025 * fixtureBalance / (risk + cost), 2.0 * fixtureBalance / close)
                    totalSteps := int(math.floor(rawQty / QSTEP))
                    firstSteps := int(math.floor(totalSteps / 2))
                    secondSteps := totalSteps - firstSteps
                    // Frozen minima: one BTC step per leg, entry notional >= 5.
                    // Reduce-only exit notional minima are exempt by assumption.
                    bool entryValid = totalSteps >= 1 and totalSteps <= 150000 and (totalSteps / 1000.0) * close >= 5.0
                    bool partialValid = firstSteps >= 1 and secondSteps >= 1 and firstSteps <= 150000 and secondSteps <= 150000 and firstSteps <= 1500000 and secondSteps <= 1500000
                    array<int> used = side == 1 ? consumedLong : consumedShort
                    int pullbackId = DATA_START + (i - p) * STEP
                    bool unused = not array.includes(used, pullbackId)
                    if entryValid and partialValid and unused and not fixtureBusy and not fixtureDailyStop and fixtureEnabled
                        accepted := true
                        array.push(used, pullbackId)
                        rr1 := math.abs(tp1 - close) / risk
                        rr2 := math.abs(tp2 - close) / risk
// Data Window observations only, placed at the owning close; no signal graphics.
plot(accepted ? side : na, "SYNTHETIC C01 diagnostic direction — UNVALIDATED", offset = 1, display = display.data_window)
plot(accepted ? DATA_START + (i - p) * STEP : na, "Diagnostic pullback UTC ID", offset = 1, display = display.data_window)
plot(accepted ? pivotId : na, "Diagnostic pivot UTC ID", offset = 1, display = display.data_window)
plot(accepted ? time_close : na, "Diagnostic signal-close UTC ID", offset = 1, display = display.data_window)
plot(accepted ? slTicks : na, "Diagnostic SL integer ticks", offset = 1, display = display.data_window)
plot(accepted ? tp1Ticks : na, "Diagnostic TP1 integer ticks", offset = 1, display = display.data_window)
plot(accepted ? tp2Ticks : na, "Diagnostic TP2 integer ticks", offset = 1, display = display.data_window)
plot(accepted ? totalSteps : na, "Diagnostic total BTC steps", offset = 1, display = display.data_window)
plot(accepted ? firstSteps : na, "Diagnostic TP1 BTC steps", offset = 1, display = display.data_window)
plot(accepted ? secondSteps : na, "Diagnostic TP2 BTC steps", offset = 1, display = display.data_window)
plot(accepted ? rr1 : na, "Diagnostic actual rounded TP1 R", offset = 1, display = display.data_window)
plot(accepted ? rr2 : na, "Diagnostic actual rounded TP2 R", offset = 1, display = display.data_window)
